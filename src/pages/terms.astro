---
import Layout from "../layouts/Layout.astro";
import Hud from "../components/Hud.astro";
import Footer from "../components/Footer.astro";
import { SITE_NAME, SOCIAL } from "../consts";

const title = `Terms of Service | ${SITE_NAME}`;
const description = `Terms of Service of ${SITE_NAME}: the agreement covering use of this site and its content.`;
---

<Layout title={title} description={description}>
  <Hud />
  <main class="doc">
    <div class="shell">
      <article class="panel panel--riveted doc__panel">
        <p class="stencil">terms of service</p>
        <h1>Terms of Service</h1>
        <p class="doc__stamp">Last updated: October 23, 2026</p>

        <div class="doc__body">
          <section>
            <h2>1. Acceptance</h2>
            <p>
              Welcome to {SITE_NAME} (the "Site"). By accessing or using the Site you agree
              to be bound by these terms. If you do not agree, please do not use the Site.
            </p>
          </section>

          <section>
            <h2>2. Site Content</h2>
            <p>
              Content on the Site is provided "as is" for product introduction purposes and
              may change as the product evolves. We strive for accuracy but make no express
              or implied warranties regarding completeness or timeliness.
            </p>
          </section>

          <section>
            <h2>3. Product Availability</h2>
            <p>
              The product is an open-source, milestone-based work in progress. Feature
              descriptions, interfaces, error codes and milestone scope on the Site are
              subject to change. Live sales channels, model-backed content, payment and
              fulfillment are explicitly not shipped in the M3 milestone and may be delivered
              in later milestones; nothing here constitutes a commitment to ship a specific
              feature on a specific date.
            </p>
          </section>

          <section>
            <h2>4. Illustrative Figures</h2>
            <p>
              Order amounts, identifiers, status codes, event logs, table counts and the
              1299 CNY demo order shown on the Site are illustrative, deterministic sandbox
              fixtures used to demonstrate the closed loop. They are not real transactions,
              not benchmarks and do not represent the performance of any real workload.
            </p>
          </section>

          <section>
            <h2>5. Intellectual Property</h2>
            <p>
              The Site's copy, design and branding belong to the project team and may not be
              used commercially without permission. The software and its source code are
              governed by the license declared in their repository.
            </p>
          </section>

          <section>
            <h2>6. Acceptable Use</h2>
            <p>
              Do not use the Site in ways that could harm or disrupt its operation or
              infringe on others' rights, including malicious scraping, injection attacks,
              or impersonation of the Site.
            </p>
          </section>

          <section>
            <h2>7. Limitation of Liability</h2>
            <p>
              To the maximum extent permitted by law, the Site is not liable for any
              indirect, incidental, or consequential damages arising from use of or inability
              to use its content. The software is provided for self-hosting under the terms
              of its repository license, and you are responsible for how you operate it and
              connect it to live sales channels.
            </p>
          </section>

          <section>
            <h2>8. Changes</h2>
            <p>
              These terms may be updated; changes will be posted on this page. Continued use
              of the Site constitutes acceptance of the updated terms.
            </p>
          </section>

          <section>
            <h2>9. Contact</h2>
            <p>
              Questions about these terms can be raised via Issues on our
              <a href={SOCIAL.github}>GitHub repository</a>, or by email at
              <a href={`mailto:${SOCIAL.email}`}>{SOCIAL.email}</a>.
            </p>
          </section>
        </div>

        <a class="btn btn--ghost doc__back" href="/">Back to console</a>
      </article>
    </div>
  </main>
  <Footer />
</Layout>
