---
// Ops-console HUD bar: channels, tables, decision gates, clock
import BayjfLink from "@bay/landing-ui/components/BayjfLink.astro";
import StarOnGithub from "@bay/landing-ui/components/StarOnGithub.astro";
import Logo from "./Logo.astro";
import { SOCIAL } from "../consts";
import { getLangFromUrl, useTranslations, getAltLangPath, localizePath } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altPath = getAltLangPath(Astro.url, lang);
---

<header class="hud">
  <div class="hud__inner shell">
    <!-- left: brand -->
    <a class="hud__brand" href={localizePath("/", lang)} aria-label={t("hud.home")}>
      <Logo />
      <span class="hud__logo">COMMERCE&thinsp;OS</span>
      <span class="led" data-c="power" aria-hidden="true"></span>
    </a>

    <!-- center: resources -->
    <div class="hud__group">
      <div class="hud__res">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--plasma)" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/><circle cx="7" cy="7" r="1.6" fill="var(--plasma)" stroke="none"/><circle cx="14" cy="12" r="1.6" fill="var(--plasma)" stroke="none"/><circle cx="10" cy="17" r="1.6" fill="var(--plasma)" stroke="none"/></svg>
        <span class="readout">1</span>
        <span class="hud__label">{t("hud.channels")}</span>
      </div>
      <div class="hud__res">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--data)" stroke-width="1.8"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/></svg>
        <span class="readout">10</span>
        <span class="hud__label">{t("hud.tables")}</span>
      </div>
      <div class="hud__res">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ok)" stroke-width="1.8"><path d="M12 3l7 3v6c0 4.4-3 7.2-7 9-4-1.8-7-4.6-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
        <span class="readout">D0–D3</span>
        <span class="hud__label">{t("hud.gates")}</span>
      </div>
    </div>

    <!-- right: clock + status -->
    <div class="hud__group hud__group--right">
      <div class="hud__stat">
        <span class="led" data-c="ok" aria-hidden="true"></span>
        <span class="readout">{t("hud.status")}</span>
      </div>
      <div class="hud__stat">
        <span class="readout" id="res-clock">--:--:--</span>
      </div>
      <div class="hud__ext">
        <BayjfLink size={17} />
        <StarOnGithub href={SOCIAL.github} size={15} />
      </div>
      <!-- outside .hud__ext: the switch is functional, so it survives every
           breakpoint where the decorative brand links do not -->
      <a class="lang-switch" href={altPath} hreflang={lang === "zh" ? "en" : "zh-CN"}>
        {t("nav.langSwitch")}
      </a>
    </div>
  </div>
  <!-- bottom border glow -->
  <div class="hud__glow" aria-hidden="true"></div>
</header>

<style>
  .hud {
    position: sticky;
    top: 0;
    z-index: 50;
    background: linear-gradient(180deg, var(--steel-900) 0%, var(--steel-850) 100%);
    border-bottom: 1px solid var(--steel-600);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.7);
  }
  .hud__glow {
    height: 1px;
    background: linear-gradient(90deg, transparent 10%, var(--data) 40%, var(--power) 60%, transparent 90%);
    opacity: 0.18;
  }
  .hud__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    gap: 16px;
  }
  .hud__group {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .hud__group--right {
    gap: 20px;
  }
  .hud__res {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
  }
  .hud__res .readout {
    font-size: 15px;
    color: var(--ink);
  }
  .hud__label {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
    align-self: flex-end;
    margin-bottom: 1px;
  }
  .hud__brand {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: none;
    --logo-size: 22px;
  }
  .hud__logo {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.28em;
    background: linear-gradient(90deg, var(--data), var(--power));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hud__stat {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-dim);
  }
  .hud__stat .readout {
    font-size: 11px;
  }
  .hud__ext {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-left: 18px;
    border-left: 1px solid var(--steel-600);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
  }
  /* :global, because these anchors come from @bay/landing-ui and so carry that
     component's scope attribute rather than this one's */
  .hud__ext :global(a) {
    transition: color 160ms ease-out;
  }
  .hud__ext :global(a:hover) {
    color: var(--data);
  }

  @media (max-width: 1100px) {
    /* the decorative status readout yields first, so the brand links survive longer */
    .hud__group--right .hud__stat:first-child { display: none; }
  }

  @media (max-width: 1000px) {
    /* icons still identify the readouts, so the word labels can go next */
    .hud__res .hud__label { display: none; }
    .hud__group { gap: 16px; }
  }

  @media (max-width: 900px) {
    /* out of room in the bar; the footer still carries both links */
    .hud__ext { display: none; }
  }

  @media (max-width: 720px) {
    .hud__inner { height: 44px; }
    .hud__logo { font-size: 12px; letter-spacing: 0.2em; }
    .hud__brand { gap: 7px; --logo-size: 19px; }
    /* the brand now owns the left slot, so the bar can only carry one readout */
    .hud__res:not(:first-child) { display: none; }
  }

  @media (max-width: 560px) {
    /* the switch needs the room and the clock is the most decorative readout */
    .hud__group--right .hud__stat { display: none; }
  }

  @media (max-width: 360px) {
    /* brand + switch only; every readout has yielded */
    .hud__group:not(.hud__group--right) { display: none; }
  }
</style>
